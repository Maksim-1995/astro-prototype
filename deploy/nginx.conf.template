server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;
    server_tokens off;

    # Docker DNS; refresh cached addresses after backend recreation.
    resolver 127.0.0.11 valid=5s ipv6=off;
    resolver_timeout 5s;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # The startup script writes outside the read-only frontend mount.
    location = /config.js {
        alias /etc/nginx/generated/config.js;
        default_type application/javascript;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location = /api { return 308 /api/; }
    location = /admin { return 308 /admin/; }

    location ~ ^/(api|admin)/ {
        client_max_body_size 16k;
        set $backend_address backend:8000;
        proxy_pass http://$backend_address;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite user-supplied XFF: DRF trusts exactly this one proxy.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
    }

    location /static/ {
        alias /srv/django-static/;
        expires 1h;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1d;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
