# Copy to .env. Never commit the resulting file or use these examples as secrets.
# Generate DJANGO_SECRET_KEY: python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
DJANGO_SECRET_KEY=
DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local Docker uses HTTP. Enable both flags only after HTTPS is configured.
DJANGO_COOKIE_SECURE=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_HSTS_SECONDS=0

DB_NAME=astro
DB_USER=astro
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# Empty for the same-origin Docker frontend. For Sites, set the exact HTTPS origin.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Keep disabled until the real privacy policy and consent wording are approved.
PUBLIC_SIGNUPS_ENABLED=False
PRIVACY_POLICY_VERSION=
PUBLIC_PRIVACY_POLICY_URL=

# Nginx is the only published application port; backend and DB remain internal.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
